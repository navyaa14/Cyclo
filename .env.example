# Copy this file to .env (same folder) and paste your key. The app loads it automatically.
# Never commit or share .env.
# Option A: Gemini API key (Google AI Studio)
GEMINI_API_KEY=your-key-here
# Option B: Vertex AI (use instead of the key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash
# Set to 1 to force deterministic fallbacks (e.g. for tests or a no-network demo)
CYCLOPS_DISABLE_GEMINI=0
CYCLOPS_REPORT_RATE_PER_MIN=30
